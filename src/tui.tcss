/* Screen Structure */
#title-bar {
    height: 7%;
    align: center middle;
}

#title-spacer,
#runtime-status {
    width: 1fr;
    height: 100%;
}

#title-content {
    width: auto;
    height: 100%;
    align: center middle;
}

#runtime-status {
    content-align: right middle;
    padding-right: 1;
    color: $text-muted;
}

#sidebar {
    width: 20%;
    padding: 0 1;
}

#sidebar-list {
    padding: 1 1;
}

.sidebar-item {
    padding: 1;
    margin: 0 0;
}

#main-panel {
    padding: 0 1;
}

#main-content-switcher {
    height: 75%;
    border: round #374558;
}

#log {
    height: 25%;
    border: round #374558;
}

Footer {
    margin: 1 1;
    width: 100%;
}

/* Bash View Styles */
#bash-title {
    width: 1fr;
    height: 3;
    content-align: left middle;
    text-style: bold;
}

#bash-subtitle {
    margin: 0 1;
    height: auto;
    text-style: italic;
}

#bash-controls {
    height: 3;
    margin: 0 1;
}

#bash-controls Button {
    margin-right: 1;
    min-width: 14;
    width: 14;
}

#bash-status {
    margin: 0 1;
    height: auto;
    max-height: 4;
}

#bash-terminal {
    height: 1fr;
    min-height: 5;
    margin: 0 1;
    border: round #374558;
    overflow: hidden hidden;
}

#bash-terminal:focus {
    border: round $accent;
}

/* Scripts View Styles */
#ascii-art {
    height: auto;
}

#scripts-view {
    height: 1fr;
    padding: 1;
}

#scripts-container {
    height: 1fr;
}

#scripts-title {
    height: 1;
    text-style: bold;
}

#scripts-label {
    height: auto;
    max-height: 2;
    margin-bottom: 1;
}

#script-search {
    height: 3;
    margin-bottom: 1;
}

#scripts-browser {
    height: 1fr;
    min-height: 10;
}

#script-list {
    width: 58%;
    min-width: 32;
    border: round #374558;
}

#script-list > .option-list--separator {
    color: $accent;
    text-style: bold;
}

#scripts-browser OptionList:focus {
    border: round $accent;
}

#script-details-scroll {
    width: 42%;
    height: 1fr;
}

#script-details {
    width: 1fr;
    height: auto;
    padding: 1 2;
}

#script-details-title {
    height: auto;
    text-style: bold;
}

#script-details-description {
    height: auto;
    margin-top: 1;
}

#script-actions {
    height: auto;
    margin-top: 1;
}

#script-actions Button {
    width: 1fr;
    min-width: 16;
    margin-bottom: 1;
}

ScriptDescriptionDialog {
    align: center middle;
}

#script-description-dialog {
    width: 70%;
    height: 60%;
    min-height: 14;
    padding: 1 2;
    border: thick #374558;
    background: $surface;
}

#script-description-title {
    height: 1;
    text-style: bold;
}

#script-description-script-name {
    height: auto;
    margin-bottom: 1;
}

#script-description-input {
    height: 1fr;
    min-height: 5;
    border: round #374558;
}

#script-description-buttons {
    height: 3;
    align: right middle;
    margin-top: 1;
}

#script-description-buttons Button {
    min-width: 14;
    margin-left: 1;
}

/* Offline Utilities View */
#utilities-view {
    height: 1fr;
    padding: 1;
}

#utilities-container {
    height: 1fr;
}

#utilities-title {
    height: 1;
    text-style: bold;
}

#utilities-subtitle {
    height: auto;
    max-height: 2;
    margin-bottom: 1;
}

#utility-search {
    height: 3;
    margin-bottom: 1;
}

#utilities-browser {
    height: 1fr;
    min-height: 10;
}

#utility-list {
    width: 58%;
    min-width: 32;
    border: round #374558;
}

#utility-list > .option-list--separator {
    color: $accent;
    text-style: bold;
}

#utilities-browser OptionList:focus {
    border: round $accent;
}

#utility-details {
    width: 42%;
    padding: 1 2;
}

#utility-details-title {
    height: auto;
    text-style: bold;
}

#utility-details-description {
    height: auto;
    margin-top: 1;
}

#utility-open {
    margin-top: 1;
}

UtilityDialog {
    align: center middle;
}

#utility-dialog {
    width: 92%;
    height: 90%;
    padding: 1 2;
    border: thick #374558;
    background: $surface;
}

#utility-dialog-title {
    height: 1;
    text-style: bold;
}

#utility-dialog-description {
    height: auto;
    max-height: 3;
    margin-bottom: 1;
}

.utility-field-label {
    height: 1;
    margin-top: 1;
    text-style: bold;
}

#utility-input,
#utility-second-input,
#utility-output {
    height: 1fr;
    min-height: 3;
    border: round #374558;
}

#utility-inputs-row {
    height: 1fr;
    min-height: 6;
}

.utility-input-column {
    width: 50%;
    height: 1fr;
    padding-right: 1;
}

#utility-dialog-buttons {
    height: 3;
    align: right middle;
    margin-top: 1;
}

#utility-dialog-buttons Button {
    min-width: 14;
    margin-left: 1;
}

/* Script Editor Dialog Styles */
ScriptEditorDialog {
    align: center middle;
}

#script-editor-dialog {
    width: 85%;
    height: 85%;
    padding: 1 2;
    border: thick #374558;
    background: $surface;
}

#script-editor-title {
    text-style: bold;
    margin-bottom: 1;
}

#script-editor-content {
    height: 1fr;
}

#script-editor-status {
    color: $error;
    min-height: 1;
}

#script-editor-buttons {
    height: 3;
    align: right middle;
}

#script-editor-save {
    margin-right: 1;
}

/* Confirm Dialog Styles */
ConfirmDialog {
    align: center middle;
}

#dialog {
    padding: 2;
    width: 30%;
    height: 40%;
    border: thick;
}

#dialog-message {
    text-align: center;
    text-style: bold;
    padding: 0 0 1 0;
}

#dialog-parameters {
    margin: 1 0;
}

#dialog-buttons {
    align: center bottom;
}

#dialog-confirm-yes {
    margin: 0 10 0 0;
}

/* Settings View Styles */
#settings-title {
    margin: 1 0 0 1;
    text-style: bold;
}

#settings-subtitle {
    margin: 0 0 1 1;
    text-style: italic;
}

#settings-columns {
    height: 1fr;
    min-height: 26;
}

#settings-left-column,
#settings-right-column {
    width: 50%;
    min-width: 0;
    height: 100%;
}

#paths-settings {
    border: round #374558;
    padding: 1;
}

#settings-directories-title {
    margin: 0 0 1 0;
    text-style: bold;
}

.settings-general-label-italic {
    text-style: italic;
    text-wrap: wrap;
    color: #99c0fac9
}

#settings-directories-scripts-input {
    margin: 1 -1;
}

#settings-directories-notes-input {
    margin: 1 -1;
}

.settings-directories-buttons {
    margin: 1 0;
    min-height: 3;
}

#settings-directories-scripts-change-button {
    margin: 0 1 0 0;
}

#settings-directories-notes-change-button {
    margin: 0 1 0 0;
}

#other-settings {
    border: round #374558;
    padding: 1;
}

#settings-other-title {
    margin: 0 0 1 0;
    text-style: bold;
}

#settings-logs-settings {
    height: 1fr;
    min-height: 12;
    border: round #374558;
    padding: 0 1;
}

#settings-logs-title {
    text-style: bold;
    margin: 0;
}

#settings-logs-table {
    height: 1fr;
    min-height: 3;
}

#settings-logs-buttons {
    height: 3;
}

#settings-logs-buttons Button,
#settings-services-buttons Button {
    width: 12;
    min-width: 12;
    margin-right: 1;
}

#settings-logs-add,
#settings-logs-edit,
#settings-services-add,
#settings-services-edit {
    background: #2864b4;
    color: white;
}

.halloween-theme #settings-logs-add,
.halloween-theme #settings-logs-edit,
.halloween-theme #settings-services-add,
.halloween-theme #settings-services-edit {
    background: #c026d3;
    color: white;
}

.halloween-theme #settings-logs-add:hover,
.halloween-theme #settings-logs-edit:hover,
.halloween-theme #settings-services-add:hover,
.halloween-theme #settings-services-edit:hover {
    background: #e879f9;
    color: #1a1124;
}

.christmas-theme #settings-logs-add,
.christmas-theme #settings-logs-edit,
.christmas-theme #settings-services-add,
.christmas-theme #settings-services-edit {
    background: #16a34a;
    color: white;
}

.christmas-theme #settings-logs-add:hover,
.christmas-theme #settings-logs-edit:hover,
.christmas-theme #settings-services-add:hover,
.christmas-theme #settings-services-edit:hover {
    background: #4ade80;
    color: #0c1711;
}

.netrunner-theme #main-content-switcher,
.netrunner-theme #log,
.netrunner-theme #bash-terminal,
.netrunner-theme #utility-list,
.netrunner-theme #script-list,
.netrunner-theme #utility-input,
.netrunner-theme #utility-second-input,
.netrunner-theme #utility-output,
.netrunner-theme #script-editor-content,
.netrunner-theme #script-description-input,
.netrunner-theme #log-files-list,
.netrunner-theme #log-file-content {
    border: round #5c1727;
}

.netrunner-theme #utility-dialog,
.netrunner-theme #script-editor-dialog,
.netrunner-theme #script-description-dialog,
.netrunner-theme #log-files-dialog,
.netrunner-theme #log-file-dialog,
.netrunner-theme #log-config-dialog,
.netrunner-theme #health-config-dialog {
    border: thick #5c1727;
}

.netrunner-theme #paths-settings,
.netrunner-theme #other-settings,
.netrunner-theme #settings-logs-settings,
.netrunner-theme #settings-services-settings {
    border: round #5c1727;
}

.netrunner-theme #logs-entries .logs-entry,
.netrunner-theme #health-checks-entries .health-check-entry {
    border: round #5c1727;
}

.netrunner-theme #todo-editor-dialog,
.netrunner-theme #new-note-dialog,
.netrunner-theme #dialog {
    border: thick #5c1727;
}

.netrunner-theme .settings-general-label-italic,
.netrunner-theme #log-files-location {
    color: #e89aa8;
}

.netrunner-theme #settings-logs-add,
.netrunner-theme #settings-logs-edit,
.netrunner-theme #settings-services-add,
.netrunner-theme #settings-services-edit {
    background: #b00020;
    color: #fff0f2;
}

.netrunner-theme #settings-logs-add:hover,
.netrunner-theme #settings-logs-edit:hover,
.netrunner-theme #settings-services-add:hover,
.netrunner-theme #settings-services-edit:hover {
    background: #ff1744;
    color: #080608;
}

#settings-services-settings {
    height: 1fr;
    min-height: 12;
    border: round #374558;
    padding: 0 1;
    margin-top: 1;
}

#settings-services-title {
    text-style: bold;
    margin: 0;
}

#settings-services-table {
    height: 1fr;
    min-height: 3;
}

#settings-services-buttons {
    height: 3;
}

/* Notes and MD Views Styles */
#notes-directory-tree-wrapper {
    width: 35%;
}

#file-title {
    margin-top: 1;
    margin-bottom: 1;
}

.icon-button {
    height: 3;
    padding: 0;
    margin-right: 1;
    content-align: center middle;
}

.icon-button:focus {
    text-style: none;
}

#notes-container {
    height: 90%;
}

#select-file-label {
    padding: 1;
    text-style: bold;
}

/* My Projects View Styles */
#projects-label {
    padding: 1;
    text-style: bold;
}

#settings-directories-projects-input {
    margin: 1 -1;
}

/* TODO View */
#todos-view,
#todos-content {
    height: 100%;
}

#todos-title {
    padding: 0 1;
    text-style: bold;
}

#todos-summary {
    margin: 0 1;
}

#todos-progress {
    margin: 0 1;
}

#todos-table {
    height: 1fr;
    min-height: 3;
    margin: 0 1;
}

#todos-controls {
    height: 3;
    margin: 0 1;
}

#todos-controls Button {
    margin-right: 1;
}

#todos-sort {
    width: 20;
    height: 3;
    margin-left: 1;
}

TodoEditorDialog {
    align: center middle;
}

#todo-editor-dialog {
    width: 70%;
    height: auto;
    max-height: 95%;
    padding: 1;
    border: thick #374558;
    background: $surface;
    overflow-y: auto;
}

#todo-editor-title {
    text-style: bold;
    margin-bottom: 1;
}

.todo-editor-label {
    margin-top: 1;
}

#todo-editor-description {
    height: 5;
    min-height: 5;
}

#todo-editor-priority {
    width: 1fr;
    height: 3;
    min-height: 3;
}

#todo-editor-error {
    min-height: 1;
    color: $error;
}

#todo-editor-buttons {
    height: 3;
    align: right middle;
}

#todo-editor-buttons Button {
    margin-left: 1;
}

NewNoteDialog {
    align: center middle;
}

#new-note-dialog {
    width: 60%;
    height: auto;
    max-height: 90%;
    padding: 2;
    border: thick #374558;
    background: $surface;
}

#new-note-title {
    text-style: bold;
    margin-bottom: 1;
}

.new-note-label {
    margin-top: 1;
}

#new-note-error {
    min-height: 1;
    color: $error;
    margin-top: 1;
}

#new-note-buttons {
    height: 3;
    align: right middle;
    margin-top: 1;
}

#new-note-buttons Button {
    margin-left: 1;
}

/* Logs View and Dialogs */
#logs-title {
    padding: 1;
    text-style: bold;
}

#logs-subtitle {
    margin: 0 1 1 1;
    text-style: italic;
}

/* Health Checks View */
#health-checks-title {
    padding: 1;
    text-style: bold;
}

#health-checks-subtitle {
    margin: 0 1 1 1;
    text-style: italic;
}

#health-checks-entries {
    height: 1fr;
    padding: 0 1;
}

.health-check-entry {
    height: 5;
    border: round #374558;
    padding: 0 1;
    margin-bottom: 1;
    align: left middle;
}

.health-status {
    width: 10;
    content-align: left middle;
    text-style: bold;
}

.health-check-name {
    width: 20%;
    content-align: left middle;
    text-style: bold;
}

.health-check-target {
    width: 1fr;
    content-align: left middle;
    text-wrap: nowrap;
}

.health-check-detail {
    width: 30%;
    content-align: left middle;
    text-wrap: wrap;
}

.health-check-entry Button {
    width: 15;
}

#logs-entries {
    height: 1fr;
    padding: 0 1;
}

.logs-entry {
    height: 5;
    border: round #374558;
    padding: 0 1;
    margin-bottom: 1;
    align: left middle;
}

.logs-entry-name {
    width: 25%;
    content-align: left middle;
    text-style: bold;
}

.logs-entry-location {
    width: 1fr;
    content-align: left middle;
    text-wrap: nowrap;
}

.logs-entry Button {
    width: 14;
}

LogFilesDialog,
LogFileDialog,
LogConfigDialog {
    align: center middle;
}

#log-files-dialog,
#log-file-dialog {
    width: 85%;
    height: 85%;
    padding: 1 2;
    border: thick #374558;
    background: $surface;
}

#log-files-title,
#log-file-title,
#log-config-title {
    text-style: bold;
    margin-bottom: 1;
}

#log-files-location,
#log-file-location {
    color: #99c0fac9;
    margin-bottom: 1;
}

#log-files-list {
    height: 1fr;
    border: round #374558;
}

#log-files-status {
    min-height: 1;
    color: $warning;
}

#log-files-buttons,
#log-file-buttons,
#log-config-buttons {
    height: 3;
    align: right middle;
    margin-top: 1;
}

#log-files-buttons Button,
#log-file-buttons Button,
#log-config-buttons Button {
    margin-left: 1;
}

#log-file-content {
    height: 1fr;
    border: round #374558;
}

#log-config-dialog {
    width: 70%;
    height: auto;
    max-height: 80%;
    padding: 2;
    border: thick #374558;
    background: $surface;
}

.log-config-label {
    margin-top: 1;
}

#log-config-error {
    min-height: 1;
    color: $error;
    margin-top: 1;
}

HealthCheckConfigDialog {
    align: center middle;
}

#health-config-dialog {
    width: 70%;
    height: auto;
    max-height: 90%;
    padding: 2;
    border: thick #374558;
    background: $surface;
}

#health-config-title {
    text-style: bold;
    margin-bottom: 1;
}

.health-config-label {
    margin-top: 1;
}

#health-config-error {
    min-height: 1;
    color: $error;
    margin-top: 1;
}

#health-config-buttons {
    height: 3;
    align: right middle;
    margin-top: 1;
}

#health-config-buttons Button {
    margin-left: 1;
}

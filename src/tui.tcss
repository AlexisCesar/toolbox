/* Screen Structure */
#title-bar {
    height: 7%;
    align: center middle;
}

#sidebar {
    width: 20%;
    padding: 0 1;
}

#sidebar-list {
    padding: 1 1;
}

.sidebar-item {
    padding: 1;
    margin: 0 0;
}

#main-panel {
    padding: 0 1;
}

#main-content-switcher {
    height: 75%;
    border: round #374558;
}

#log {
    height: 25%;
    border: round #374558;
}

Footer {
    margin: 1 1;
    width: 100%;
}

/* Scripts View Styles */
#scripts-label {
    padding: 1;
    text-style: bold;
}

/* Script Editor Dialog Styles */
ScriptEditorDialog {
    align: center middle;
}

#script-editor-dialog {
    width: 85%;
    height: 85%;
    padding: 1 2;
    border: thick #374558;
    background: $surface;
}

#script-editor-title {
    text-style: bold;
    margin-bottom: 1;
}

#script-editor-content {
    height: 1fr;
}

#script-editor-status {
    color: $error;
    min-height: 1;
}

#script-editor-buttons {
    height: 3;
    align: right middle;
}

#script-editor-save {
    margin-right: 1;
}

/* Script Inspection Dialog Styles */
ScriptInspectionDialog {
    align: center middle;
}

#script-inspection-dialog {
    width: 85%;
    height: 85%;
    padding: 1 2;
    border: thick #374558;
    background: $surface;
}

#script-inspection-title {
    text-style: bold;
    margin-bottom: 1;
}

#script-inspection-content {
    height: 1fr;
}

#script-inspection-buttons {
    height: 3;
    align: right middle;
    margin-top: 1;
}

/* Confirm Dialog Styles */
ConfirmDialog {
    align: center middle;
}

#dialog {
    padding: 2;
    width: 30%;
    height: 40%;
    border: thick;
}

#dialog-message {
    text-align: center;
    text-style: bold;
    padding: 0 0 1 0;
}

#dialog-parameters {
    margin: 1 0;
}

#dialog-buttons {
    align: center bottom;
}

#dialog-confirm-yes {
    margin: 0 10 0 0;
}

/* Settings View Styles */
#settings-title {
    margin: 1 0 0 1;
    text-style: bold;
}

#settings-subtitle {
    margin: 0 0 1 1;
    text-style: italic;
}

#settings-columns {
    height: 1fr;
    min-height: 26;
}

#settings-left-column,
#settings-right-column {
    width: 1fr;
    height: 100%;
}

#paths-settings {
    border: round #374558;
    height: 70%;
    padding: 1;
}

#settings-directories-title {
    margin: 0 0 1 0;
    text-style: bold;
}

.settings-general-label-italic {
    text-style: italic;
    text-wrap: wrap;
    color: #99c0fac9
}

#settings-directories-scripts-input {
    margin: 1 -1;
}

#settings-directories-notes-input {
    margin: 1 -1;
}

.settings-directories-buttons {
    margin: 1 0;
    min-height: 3;
}

#settings-directories-scripts-change-button {
    margin: 0 1 0 0;
}

#settings-directories-notes-change-button {
    margin: 0 1 0 0;
}

#theme-settings {
    border: round #374558;
    padding: 1;
}

#settings-theme-title {
    margin: 0 0 1 0;
    text-style: bold;
}

#settings-logs-settings {
    height: 1fr;
    min-height: 12;
    border: round #374558;
    padding: 0 1;
}

#settings-logs-title {
    text-style: bold;
    margin: 0;
}

#settings-logs-table {
    height: 1fr;
    min-height: 3;
}

#settings-logs-buttons {
    height: 3;
}

#settings-logs-buttons Button {
    margin-right: 1;
}

#settings-services-settings {
    height: 1fr;
    min-height: 12;
    border: round #374558;
    padding: 0 1;
    margin-top: 1;
}

#settings-services-title {
    text-style: bold;
    margin: 0;
}

#settings-services-table {
    height: 1fr;
    min-height: 3;
}

#settings-services-buttons {
    height: 3;
}

#settings-services-buttons Button {
    margin-right: 1;
}

/* Notes and MD Views Styles */
#notes-directory-tree-wrapper {
    width: 35%;
}

#file-title {
    margin-top: 1;
    margin-bottom: 1;
}

.icon-button {
    height: 3;
    padding: 0;
    margin-right: 1;
    content-align: center middle;
}

.icon-button:focus {
    text-style: none;
}

#notes-container {
    height: 90%;
}

#select-file-label {
    padding: 1;
    text-style: bold;
}

/* My Projects View Styles */
#projects-label {
    padding: 1;
    text-style: bold;
}

#settings-directories-projects-input {
    margin: 1 -1;
}

/* Logs View and Dialogs */
#logs-title {
    padding: 1;
    text-style: bold;
}

#logs-subtitle {
    margin: 0 1 1 1;
    text-style: italic;
}

/* Health Checks View */
#health-checks-title {
    padding: 1;
    text-style: bold;
}

#health-checks-subtitle {
    margin: 0 1 1 1;
    text-style: italic;
}

#health-checks-entries {
    height: 1fr;
    padding: 0 1;
}

.health-check-entry {
    height: 5;
    border: round #374558;
    padding: 0 1;
    margin-bottom: 1;
    align: left middle;
}

.health-status {
    width: 10;
    content-align: left middle;
    text-style: bold;
}

.health-check-name {
    width: 20%;
    content-align: left middle;
    text-style: bold;
}

.health-check-target {
    width: 1fr;
    content-align: left middle;
    text-wrap: nowrap;
}

.health-check-detail {
    width: 30%;
    content-align: left middle;
    text-wrap: wrap;
}

.health-check-entry Button {
    width: 15;
}

#logs-entries {
    height: 1fr;
    padding: 0 1;
}

.logs-entry {
    height: 5;
    border: round #374558;
    padding: 0 1;
    margin-bottom: 1;
    align: left middle;
}

.logs-entry-name {
    width: 25%;
    content-align: left middle;
    text-style: bold;
}

.logs-entry-location {
    width: 1fr;
    content-align: left middle;
    text-wrap: nowrap;
}

.logs-entry Button {
    width: 14;
}

LogFilesDialog,
LogFileDialog,
LogConfigDialog {
    align: center middle;
}

#log-files-dialog,
#log-file-dialog {
    width: 85%;
    height: 85%;
    padding: 1 2;
    border: thick #374558;
    background: $surface;
}

#log-files-title,
#log-file-title,
#log-config-title {
    text-style: bold;
    margin-bottom: 1;
}

#log-files-location,
#log-file-location {
    color: #99c0fac9;
    margin-bottom: 1;
}

#log-files-list {
    height: 1fr;
    border: round #374558;
}

#log-files-status {
    min-height: 1;
    color: $warning;
}

#log-files-buttons,
#log-file-buttons,
#log-config-buttons {
    height: 3;
    align: right middle;
    margin-top: 1;
}

#log-files-buttons Button,
#log-file-buttons Button,
#log-config-buttons Button {
    margin-left: 1;
}

#log-file-content {
    height: 1fr;
    border: round #374558;
}

#log-config-dialog {
    width: 70%;
    height: auto;
    max-height: 80%;
    padding: 2;
    border: thick #374558;
    background: $surface;
}

.log-config-label {
    margin-top: 1;
}

#log-config-error {
    min-height: 1;
    color: $error;
    margin-top: 1;
}

HealthCheckConfigDialog {
    align: center middle;
}

#health-config-dialog {
    width: 70%;
    height: auto;
    max-height: 90%;
    padding: 2;
    border: thick #374558;
    background: $surface;
}

#health-config-title {
    text-style: bold;
    margin-bottom: 1;
}

.health-config-label {
    margin-top: 1;
}

#health-config-error {
    min-height: 1;
    color: $error;
    margin-top: 1;
}

#health-config-buttons {
    height: 3;
    align: right middle;
    margin-top: 1;
}

#health-config-buttons Button {
    margin-left: 1;
}
